my $version = "plus-1.3.0";

my %opts;
my %decorations = (
	castle		=> \&add_castle,
	treasure	=> \&add_treasure,
	skull		=> \&add_skull,
	anchor		=> \&add_anchor,
);
# everything but the castle has sunk here; random (the default) picks one per scene
my @sunken = grep { $_ ne 'castle' } sort keys %decorations;

# flags beat the config file, which beats these
my %defaults = (
	decoration	=> 'random',
	cooldown	=> 30,
);
my $config_file = ($ENV{'XDG_CONFIG_HOME'} || ($ENV{'HOME'} || '') . '/.config') . '/asciiquarium-plus/config';
my %config = read_config($config_file);

my $usage = "usage: $0 [-d random|" . join('|', sort keys %decorations) . "] [-e seconds]\n" .
	"  -d  what sits on the sea floor (default $defaults{'decoration'})\n" .
	"  -e  cooldown between events (default $defaults{'cooldown'})\n" .
	"defaults can be set in $config_file\n";
getopts('d:e:', \%opts) or die $usage;
my $decoration = defined($opts{'d'}) ? $opts{'d'} : $config{'decoration'};
die $usage unless($decoration eq 'random' or exists($decorations{$decoration}));
my $event_cooldown = defined($opts{'e'}) ? $opts{'e'} : $config{'cooldown'};
die $usage unless($event_cooldown =~ /^\d+$/);
my $next_event = 0;

# a new fish named after a running agent swims in every $name_period / <agents> seconds:
# 16s with one agent, 4s with four
my $name_period = 16;

my @random_objects = init_random_objects();

# the Z depth at which certain items occur
my %depth = (
	# no gui yet
	guiText		=> 0,
	gui		=> 1,

	# under water
	shark		=> 2,
	fish_start	=> 3,
	fish_end	=> 20,
	seaweed		=> 21, 
	castle		=> 22,

	# waterline
	water_line3	=> 2,
	water_gap3	=> 3,
	water_line2	=> 4,
	water_gap2	=> 5,
	water_line1	=> 6,
	water_gap1	=> 7,
	water_line0	=> 8,
	water_gap0	=> 9,
);

# tests load the script to call its subs without starting the animation
main() unless(caller);

####################### MAIN #######################

sub main {

	my $anim = Term::Animation->new();

	# set the wait time for getch
	halfdelay(1);
	#nodelay(1);

	$anim->color(1);

	my $start_time = time;
	my $paused = 0;
	while(1) {

		add_environment($anim);
		my $name = $decoration eq 'random' ? $sunken[int(rand(@sunken))] : $decoration;
		$decorations{$name}->($anim);
		add_all_seaweed($anim);
		add_all_fish($anim);
		$next_event = int(rand(@random_objects));	# each scene opens with a random event
		random_object(undef, $anim);
		name_fish(undef, $anim);
		
		$anim->redraw_screen();

		my $nexttime = 0;

		while(1) {
			my $in = getch();

			if   ( $in eq 'q' ) { quit(); }   # Exit
			elsif( $in eq 'r' || $in eq KEY_RESIZE()) { last; }     # Redraw (will recreate all objects)
			elsif( $in eq 'p' ) { $paused = !$paused; }

			$anim->animate() unless($paused);
		}
		$anim->update_term_size();
		$anim->remove_all_entities();

	}

}

sub add_environment {
	my ($anim) = @_;

	my @water_line_segment = (
		q{~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~},
		q{^^^^ ^^^  ^^^   ^^^    ^^^^      },
		q{^^^^      ^^^^     ^^^    ^^     },
		q{^^      ^^^^      ^^^    ^^^^^^  }
	);

	# tile the segments so they stretch across the screen
	my $segment_size = length($water_line_segment[0]);
	my $segment_repeat = int($anim->width()/$segment_size) + 1;
	foreach my $i (0..$#water_line_segment) {
		$water_line_segment[$i] = $water_line_segment[$i]x$segment_repeat;
	}

	foreach my $i (0..$#water_line_segment) {
		$anim->new_entity(
			name		=> "water_seg_$i",
			type		=> "waterline",
			shape		=> $water_line_segment[$i],
			position	=> [ 0, $i+5, $depth{'water_line'  . $i} ],
			default_color	=> 'cyan',
			depth		=> 22,
			physical	=> 1,
		);
	}
}

