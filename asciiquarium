# events take turns in order. a new scene starts a random one right away;
# when an event ends, the next one waits out the cooldown first
sub random_object {
	my ($dead_object, $anim) = @_;
	if(not defined($dead_object) or $event_cooldown == 0) {
		my $event = $random_objects[$next_event];
		$next_event = ($next_event + 1) % @random_objects;
		$event->(undef, $anim);
		return;
	}
	# invisible placeholder whose death starts the next event
	$anim->new_entity(
		shape		=> ' ',
		position	=> [ 0, 0, $depth{'guiText'} ],
		die_time	=> time() + $event_cooldown,
		death_cb	=> sub { random_object(undef, $_[1]) },
	);
}

# sends in a new fish named after a random agent that isn't swimming yet, then
# schedules the next one
sub name_fish {
	my (undef, $anim) = @_;
	# compared as shown: two names that only differ past the cut would look like one
	my %seen;
	my @names = grep { !$seen{$_}++ } map { substr($_, 0, 24) } agent_names();
	# ponytail: Term::Animation checks die_time in whole seconds, so the floor is
	# one named fish a second; spawn several per tick if that ever needs to go faster
	$anim->new_entity(
		shape		=> ' ',
		position	=> [ 0, 0, $depth{'guiText'} ],
		die_time	=> time() + max(1, $name_period / (@names || 1)),
		death_cb	=> \&name_fish,
	);
	# each tag is named after its agent, so the names in use are the living tags
	my @free = grep { !$anim->entity("name_tag:$_") } @names;
	return unless(@free);
	my $name = $free[int(rand(@free))];
	# a new fish carries the name; it doesn't respawn, or the tank would keep growing
	my $fish = add_fish(undef, $anim);
	$fish->death_cb(undef);
	my $tag = $anim->new_entity(
		name		=> "name_tag:$name",
		type		=> 'name_tag',
		shape		=> $name,
		position	=> [ $fish->x, $fish->y - 1, $fish->z ],
		follow_offset	=> [ int(($fish->width - length($name)) / 2), -1, 0 ],
		default_color	=> 'WHITE',
	);
	# set after creation: Entity->new dies if given these (method call before bless)
	$tag->follow_entity($fish);
	$tag->die_entity($fish);
}

# names of the running agents: herdr knows every kind (claude, codex, ...);
# without herdr, fall back to the claude code sessions
sub agent_names {
	my @names = herdr_names(scalar(`herdr pane list 2>/dev/null`));
	return @names ? @names : session_names();
}

# the agent panes in `herdr pane list` output, by terminal title
sub herdr_names {
	my ($json) = @_;
	my $list = eval { decode_json($json // '') };
	return () unless(ref($list) eq 'HASH' and ref($list->{'result'}) eq 'HASH'
		and ref($list->{'result'}{'panes'}) eq 'ARRAY');
	my @names;
	foreach my $pane (@{$list->{'result'}{'panes'}}) {
		next unless(ref($pane) eq 'HASH' and $pane->{'agent'});
		my $name = $pane->{'terminal_title_stripped'} // '';
		# codex titles its pane "<thread> | <project>"; the thread is the name
		$name =~ s/\s+\|\s+[^|]*$// if($pane->{'agent'} eq 'codex');
		push(@names, $name) if($name =~ /\S/);
	}
	return @names;
}

# names of the running claude code sessions; each one keeps ~/.claude/sessions/<pid>.json
sub session_names {
	my ($dir) = @_;
	$dir //= ($ENV{'CLAUDE_CONFIG_DIR'} || ($ENV{'HOME'} || '') . '/.claude') . '/sessions';
	my @names;
	foreach my $file (glob("$dir/*.json")) {
		open(my $fh, '<', $file) or next;
		my $session = eval { decode_json(do { local $/; <$fh> }) };
		close($fh);
		next unless(ref($session) eq 'HASH' and $session->{'name'} and $session->{'pid'});
		# files of crashed sessions linger; only keep the ones whose process is alive
		next unless(kill(0, $session->{'pid'}) or $!{'EPERM'});
		push(@names, $session->{'name'});
	}
	return @names;
}

# "key = value" lines; # starts a comment. the file is never written, and
# anything missing, unreadable or nonsensical in it falls back to %defaults
sub read_config {
	my ($file) = @_;
	my %config = %defaults;
	return %config unless(-f $file and open(my $fh, '<', $file));
	while(my $line = <$fh>) {
		$line =~ s/#.*//;
		next unless($line =~ /^\s*(\w+)\s*=\s*(.*?)\s*$/);
		my ($key, $value) = (lc($1), lc($2));
		if($key eq 'decoration') {
			$config{'decoration'} = exists($decorations{$value}) ? $value : 'random';
		}
		elsif($key eq 'cooldown' and $value =~ /^\d+$/) {
			$config{'cooldown'} = $value;
		}
	}
	close($fh);
	return %config;
}

sub dprint {
	open(my $debug, ">>", "debug") or return;
	print $debug @_, "\n";
	close($debug);
}

sub sighandler {
	my ($sig) = @_;
	if($sig eq 'INT') { quit(); }
	elsif($sig eq 'WINCH') {
		# ignore SIGWINCH, only redraw when requested
	}
	else { quit("Exiting with SIG$sig"); }
}

sub quit {
	my ($mesg) = @_;
	print STDERR $mesg, "\n" if(defined($mesg));
	exit;
}


sub initialize {
	# this may be paranoid, but i don't want to leave
	# the user's terminal in a state that they might not
	# know how to fix if we die badly
	foreach my $sig (keys %SIG) {
		$SIG{$sig} = 'sighandler' unless(defined($SIG{$sig}));
	}
}


sub center {
	my ($width, $mesg) = @_;
	my $l = length($mesg);
	if($l < $width) {
		return ' 'x(int(($width - length($mesg))/2)) . $mesg;
	}
	elsif($l > $width) {
		return(substr($mesg, 0, ($width - ($l + 3))) . "...");
	}
	else {
		return $mesg;
	}
}

